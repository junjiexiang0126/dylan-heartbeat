# Four distinct random service keys, at least 32 characters. Never commit .env.
ZIWEI_CHAT_KEY=
ZIWEI_MEMORY_WRITE_KEY=
ZIWEI_MEMORY_DELETE_KEY=
ZIWEI_ADMIN_KEY=
DEEPSEEK_API_KEY=
# No new paid calls; prior audit has reserved the entire 20 yuan allocation.
ZIWEI_BUDGET_FEN=0
ZIWEI_PRIOR_BUDGET_AUDIT=/app/prior-budget-audit.json
ZIWEI_DATA_DIR=/data/ziwei-hermes-test
