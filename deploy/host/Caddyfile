zhiweilove.me, www.zhiweilove.me {
	encode gzip
	header X-Robots-Tag "noindex, nofollow, noarchive"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	handle /push/* {
		reverse_proxy 127.0.0.1:3010
	}
	handle /push {
		reverse_proxy 127.0.0.1:3010
	}
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}

